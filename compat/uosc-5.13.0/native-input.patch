+mp.register_script_message('native-input-update', function(json)
+	local data=utils.parse_json(json)
+	local menu=Menu:is_open(data and data.type)
+	if not menu or not menu.root.native_input or not menu.current.search or type(data.display)~='string' then return end
+	menu.current.search.query=data.display
+	menu.current.search.cursor=clamp(0,tonumber(data.cursor) or #data.display,#data.display)
+	menu.current.native_selection={start=tonumber(data.selection_start) or 0,finish=tonumber(data.selection_end) or 0}
+	menu.current.native_composition={start=tonumber(data.composition_start) or -1,finish=tonumber(data.composition_end) or -1}
+	menu:select_index(nil)
+	request_render()
+end)
+
